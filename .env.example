# ─── API ───────────────────────────────────────────────────────────────────────
# Local: points at the merged Nest + stream server (npm run server:start).
# Production: relative "/api" — the same Vercel deployment serves SPA + API.
VITE_API_URL=http://localhost:4000/api
# Production: VITE_API_URL=/api

# ─── Stream endpoints (NetMirror thumbnails, proxy) ────────────────────────────
# The stream router now runs on the SAME merged backend as the API, so stream
# URLs are derived from VITE_API_URL (same-origin in production). No separate
# VITE_STREAM_SERVICE_URL anymore — the old Render stream service is retired.
# (Only set it to override if you run an external netmirror worker.)

# ─── Firebase Web SDK ─────────────────────────────────────────────────────────
# Get from: Firebase Console → Project Settings → Your apps → Web app (</>) → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── App / URLs ────────────────────────────────────────────────────────────────
# Canonical site origin used for SEO/OpenGraph links
VITE_SITE_URL=your-site-origin
# Example: VITE_SITE_URL=https://your-project.vercel.app/

# Key used to decode obfuscated trailer/stream URLs (XOR + base64)
# Keep in sync with the value used to encode URLs server-side.
VITE_URL_DECODE_KEY=your_url_decode_key_here

# ─── Backend runtime (server/, also set as Vercel env vars) ───────────────────
# TMDB_API_KEY is REQUIRED (Joi validation fails at boot without it)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_TOKEN=your_tmdb_read_access_token
# Optional: RapidAPI key for richer release-date badges on some titles
RAPIDAPI_KEY=
# Optional: Upstash Redis URL for a shared cache across serverless instances
REDIS_URL=
# CORS-allowed extra origins (comma-separated), besides localhost + the Vercel origin
FRONTEND_URL=
