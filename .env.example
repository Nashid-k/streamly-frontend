# ─── TMDB API (required) ──────────────────────────────────────────────────────
# Get from: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# ─── OMDb API (optional) ───────────────────────────────────────────────────────
# Get from: https://www.omdbapi.com/apikey.aspx
# Used for extra ratings/metadata over TMDB. If unset, the app degrades to TMDB
# ratings only (fetchOmdbByImdbId returns null). Keep it in your Vercel env —
# VITE_ vars are client-visible by design, so rotate it if it ever ships in a bundle.
VITE_OMDB_API_KEY=your_omdb_api_key_here

# ─── MongoDB Database (Atlas or local) ────────────────────────────────────────
# Connection string to MongoDB cluster (defaults to 'streamly' database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/streamly?retryWrites=true&w=majority

# ─── Google OAuth 2.0 / Google Identity Services ──────────────────────────────
# Google Cloud Console OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ─── App / URLs ────────────────────────────────────────────────────────────────
# Canonical site origin used for SEO/OpenGraph links
VITE_SITE_URL=https://your-project.vercel.app

# ─── Streamly Relay (Cloudflare Workers FREE, OPTIONAL but recommended) ───────
# A deployed Cloudflare Worker that proxies media bytes out of Vercel: no
# egress charge and no 4.5MB serverless response cap, so one request can pull a
# WHOLE fragment (Vercel had to slice every fragment server-side). The worker is
# a GET ?url= passthrough: it strips Origin/Referer/Host, forwards our Range
# header, follows redirects, and exposes content-range/content-length.
# Example (deploy once, worker code lives in your Cloudflare console):
#   export default {
#     async fetch(request, env, ctx) {
#       if (request.method === 'OPTIONS') {
#         return new Response(null, { headers: {
#           'Access-Control-Allow-Origin': '*',
#           'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
#           'Access-Control-Allow-Headers': '*',
#           'Access-Control-Max-Age': '86400' } });
#       }
#       const corsHeaders = { 'Access-Control-Allow-Origin': '*', 'Access-Control-Expose-Headers': '*' };
#       const url = new URL(request.url);
#       let targetUrlStr = url.searchParams.get('url');
#       const customReferer = url.searchParams.get('referer');
#       if (!targetUrlStr || targetUrlStr === 'undefined' || targetUrlStr === 'null') {
#         if (url.pathname !== '/' && url.pathname !== '') {
#           targetUrlStr = 'https://cinesrc.st' + url.pathname + url.search;
#         } else {
#           return new Response('Streamly Proxy is Running!', { status: 200, headers: corsHeaders });
#         }
#       }
#       let target;
#       try {
#         target = new URL(targetUrlStr);
#         if (target.protocol !== 'https:' && target.protocol !== 'http:') throw new Error('bad protocol');
#       } catch { return new Response('Bad ?url= target', { status: 400, headers: corsHeaders }); }
#       const headers = new Headers(request.headers);
#       for (const name of [...headers.keys()]) {
#         if (name.startsWith('cf-') || name === 'cdn-loop') headers.delete(name);
#       }
#       headers.delete('Origin'); headers.delete('Referer'); headers.delete('Host');
#       // The client passes its source's owning-player referer (?url=...&referer=...)
#       // — forward it so referer-gated CDNs serve us instead of 403ing a bare
#       // worker fetch. VidCore's rotation so far: moon.quietridge.top (manifests,
#       // now WAF-blocks worker egress IPs), palehive/grandpearl/wisehive/
#       // hypergate/echogate (segments), the 2026-09 rotation-4 hosts
#       // cybergate.top (TV) + lightgrove.top (movies) — gate on the browser's
#       // Origin, so the client must NOT probe them bare (gate list:
#       // nativeHlsLoader) — and rotation-5 cleartrail.top, which is fully open
#       // (ACAO * + 206 bare), so it is deliberately NOT gated.
#       if (customReferer) {
#         try {
#           const ref = new URL(customReferer);
#           headers.set('Referer', customReferer);
#           headers.set('Origin', ref.origin);
#         } catch { /* an unparseable referer is ignored, never fatal */ }
#       }
#       // OpenSubtitles UA-gates its download endpoint and JS cannot set
#       // User-Agent, so inject it here or every .gz subtitle 401s.
#       // REQUIRED for subtitles: without these 3 lines the player lists
#       // languages fine (search works) but every download fails on BOTH legs
#       // (relay 401 -> direct 401, since a browser can never send User-Agent).
#       // The app now says so in the subs pane instead of failing silently.
#       if (target.hostname === 'opensubtitles.org' || target.hostname.endsWith('.opensubtitles.org')) {
#         headers.set('User-Agent', 'TemporaryUserAgent');
#       }
#       // VERIFY after redeploy (replace WORKER with your worker host):
#       //   curl -s -o /dev/null -w "search:%{http_code}\n" "WORKER?url=https%3A%2F%2Frest.opensubtitles.org%2Fsearch%2Fimdbid-0111161"
#       // Both the search probe and a real .gz download probe must answer 200;
#       // a 401 on the download = this snippet is not live yet.
#       try {
#         const response = await fetch(targetUrlStr, {
#           method: request.method,
#           headers: headers,
#           body: request.method !== 'GET' && request.method !== 'HEAD' ? request.body : undefined,
#           redirect: 'follow'
#         });
#         const responseHeaders = new Headers(response.headers);
#         responseHeaders.set('Access-Control-Allow-Origin', '*');
#         responseHeaders.set('Access-Control-Expose-Headers', '*');
#         responseHeaders.delete('X-Frame-Options');
#         responseHeaders.delete('Content-Security-Policy');
#         return new Response(response.body, {
#           status: response.status, statusText: response.statusText, headers: responseHeaders
#         });
#       } catch (error) {
#         return new Response('Proxy error: ' + error.message, { status: 500, headers: corsHeaders });
#       }
#     }
#   };
# When set, the browser prefers this relay and falls back to /api/downloadify
# automatically (that Vercel relay can also carry the player Referer the worker
# forwards when the client supplies it). Client-visible by design.
# NOTE: after editing this snippet, REDEPLOY the worker in your Cloudflare
# console — the live proxy must be on the version with referer forwarding
# before referer-gated hosts stream through it (until then the client falls
# back to the Vercel relay, which always works).
VITE_STREAMLY_RELAY_URL=https://streamly-proxy.nashidk1999.workers.dev
