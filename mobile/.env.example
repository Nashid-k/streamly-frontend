# Streamly Android app - local environment.
#
# YOU DO NOT NEED THIS FILE. A release APK is pre-wired to the deployed Streamly
# origin (see DEPLOYED_API_BASE in src/config.ts): catalogue and playback both
# work the moment it is installed. Nothing here is required.
#
# It exists only for forks and self-hosted copies. Copy to `.env` (git-ignored)
# to change where a build points. Note that a TMDB key is NOT needed: the site's
# /api/tmdb proxy injects it server-side when the client omits one, which is how
# the key stays out of the APK entirely.

# ── Catalogue ───────────────────────────────────────────────────────────────
# The deployed origin's /api/tmdb, derived automatically. Override only to point
# at a different deployment.
EXPO_PUBLIC_TMDB_PROXY=

# Direct TMDB access with your own read token. Rarely wanted: api.themoviedb.org
# is DNS-blocked on some ISPs, which is the reason the proxy exists.
EXPO_PUBLIC_TMDB_API_KEY=

# ── Playback ─────────────────────────────────────────────────────────────────
# Origin of the deployed Streamly project, no trailing slash. The app calls
# <API_BASE>/api/downloadify (resolvevidcore, resolvevidsrc) and
# <API_BASE>/api/tmdb. React Native's fetch has no CORS layer, so cross-origin
# calls are fine.
EXPO_PUBLIC_API_BASE=https://streamlyvercelin.vercel.app

# Cloudflare passthrough used ONLY as the playback fallback, for hosts that need
# every manifest URI rewritten instead of a Referer header.
EXPO_PUBLIC_RELAY_URL=https://streamly-proxy.nashidk1999.workers.dev

# ── Diagnostics ─────────────────────────────────────────────────────────────
# 1 turns on [Streamly] info logs in addition to warnings and errors.
EXPO_PUBLIC_DEBUG=1
