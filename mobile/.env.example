# Streamly Android app - local environment.
#
# These values are the BUILDER's defaults, inlined into the JS bundle at build
# time. They are optional now: the app also accepts the same values typed on the
# device (Settings tab), persisted in AsyncStorage, and anything entered there
# WINS at request time. That is deliberate - an installed APK has no `.env`, and
# a build shipped without credentials must still be fixable without a rebuild.
#
# Copy to `.env` (git-ignored) to preconfigure a build; leave it out and let the
# user configure on-device.

# ── Catalogue ───────────────────────────────────────────────────────────────
# Option A: talk to TMDB directly with your own read key.
EXPO_PUBLIC_TMDB_API_KEY=

# Option B: stay keyless and let the deployed app's proxy inject the key.
# EXPO_PUBLIC_TMDB_API_KEY is ignored while EXPO_PUBLIC_TMDB_PROXY is set.
EXPO_PUBLIC_TMDB_PROXY=

# ── Playback ─────────────────────────────────────────────────────────────────
# Origin of the deployed Streamly Vercel project, no trailing slash. The app
# calls <API_BASE>/api/downloadify (resolvevidcore, resolvevidsrc) and
# <API_BASE>/api/tmdb. React Native's fetch has no CORS layer, so cross-origin
# calls are fine. Also the single value a user can paste into Settings to get a
# working catalogue AND playback at once.
EXPO_PUBLIC_API_BASE=https://your-app.vercel.app

# Cloudflare passthrough that injects the Referer/User-Agent the source hosts
# require. Public infrastructure, safe to keep at the default.
EXPO_PUBLIC_RELAY_URL=https://streamly-proxy.nashidk1999.workers.dev

# ── Diagnostics ─────────────────────────────────────────────────────────────
# 1 turns on [Streamly] info logs in addition to warnings and errors.
EXPO_PUBLIC_DEBUG=1
